{
  "title": "Aixker Cluster — Container Metrics",
  "uid": "aixker-cluster",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running Containers",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }] } } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(count(container_last_seen{image!=\"\"}) by (name))",
          "legendFormat": "containers"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total CPU Usage",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] } } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(container_cpu_usage_seconds_total{image!=\"\"}[1m])) * 100",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Memory Usage",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "orange", "value": 1073741824 }, { "color": "red", "value": 2147483648 }] } } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(container_memory_working_set_bytes{image!=\"\"})",
          "legendFormat": "Memory"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Network RX",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(container_network_receive_bytes_total{image!=\"\"}[1m]))",
          "legendFormat": "RX"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Network TX",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(container_network_transmit_bytes_total{image!=\"\"}[1m]))",
          "legendFormat": "TX"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU Usage per Container (%)",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(container_cpu_usage_seconds_total{image!=\"\"}[1m]) * 100",
          "legendFormat": "{{ name }}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory Usage per Container",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "container_memory_working_set_bytes{image!=\"\"}",
          "legendFormat": "{{ name }}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory Limit per Container",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "container_spec_memory_limit_bytes{image!=\"\",container_spec_memory_limit_bytes!=0}",
          "legendFormat": "{{ name }} limit"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Network RX per Container",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(container_network_receive_bytes_total{image!=\"\"}[1m])",
          "legendFormat": "{{ name }}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Network TX per Container",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(container_network_transmit_bytes_total{image!=\"\"}[1m])",
          "legendFormat": "{{ name }}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Filesystem Usage per Container",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "container_fs_usage_bytes{image!=\"\"}",
          "legendFormat": "{{ name }}"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Container Overview",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "options": { "sortBy": [{ "displayName": "CPU %", "desc": true }] },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(container_cpu_usage_seconds_total{image!=\"\"}[1m]) * 100",
          "legendFormat": "{{ name }}",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": "Prometheus",
          "expr": "container_memory_working_set_bytes{image!=\"\"}",
          "legendFormat": "{{ name }}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "CPU %",
              "Value #B": "Memory"
            }
          }
        }
      ]
    }
  ]
}
